# Backend Environment Configuration Template
# Copy this file to backend/.env and configure for your local environment
# IMPORTANT: Never commit actual passwords, API keys, or production secrets

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forbusyness_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
SECRET_KEY=your_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
